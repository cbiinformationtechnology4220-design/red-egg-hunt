# Local-only example. Never place production credentials or real printed codes here.
APP_ENV=local
VITE_APP_ENV=local
PUBLIC_SITE_URL=http://localhost:4173
VITE_PUBLIC_SITE_URL=http://localhost:4173

# The server is authoritative for opening and closing decisions.
CAMPAIGN_ID=red-egg-hunt-2026
CAMPAIGN_TITLE=Red Egg Hunt
CAMPAIGN_PRIZE=PHP50 cash voucher
CAMPAIGN_TIMEZONE=Asia/Manila
CAMPAIGN_START_AT=2026-09-24T18:00:00+08:00
CAMPAIGN_END_AT=2026-10-03T18:00:00+08:00
CAMPAIGN_TOTAL_CODES=50
PRIVACY_NOTICE_VERSION=privacy-notice-draft-1
CAMPAIGN_INSTRUCTIONS=Find a Red Egg Hunt card, scan the shared QR, and enter the eight-digit code printed beside it.
CAMPAIGN_SCREENSHOT_INSTRUCTIONS=Screenshot this acknowledgement for your records. Do not post your mobile number or other private information publicly.
CAMPAIGN_PRIVACY_NOTICE=We collect your name and mobile number privately to record this entry and support campaign operations. Do not post either detail in a public comment. The approved campaign privacy notice and retention schedule must be in place before launch.
SUPPORT_CONTACT=09952863665

# Local uses a disposable in-memory fixture. Preview and production use the
# protected Google Apps Script web app backed by a private Google Sheet.
DATABASE_PROVIDER=mock
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-web-app-id/exec
GOOGLE_APPS_SCRIPT_SHARED_SECRET=replace-with-at-least-32-random-server-only-bytes

# Staff access is a local test seam only. Production must receive an approved
# authenticated staff session signed with a rotated server-only secret.
STAFF_SESSION_COOKIE_NAME=red_egg_staff_session
STAFF_SESSION_SECRET=replace-with-at-least-32-random-server-only-bytes
STAFF_LOCAL_TEST_MODE=true
AUDIT_HASH_SECRET=replace-with-at-least-32-random-server-only-bytes
RATE_LIMIT_SECRET=replace-with-at-least-32-random-server-only-bytes
